{
  "name": "shuuka-shopify-line-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && wrangler dev",
    "deploy": "node scripts/check-node.mjs && wrangler deploy",
    "typegen": "node scripts/check-node.mjs && wrangler types",
    "typecheck": "node scripts/check-node.mjs && tsc --noEmit",
    "test": "node scripts/check-node.mjs && vitest run",
    "check": "node scripts/check-node.mjs && pnpm typegen && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@line-harness/sdk": "link:../line-harness/packages/sdk",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@11.0.9"
}
